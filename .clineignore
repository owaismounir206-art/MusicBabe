# ==============================================================================
# CLINE IGNORE RULES FOR PIXELPLAY / MUSICBABE
# ==============================================================================
# Purpose: Prevent Cline from reading, searching, indexing, or traversing
# heavy build artifacts, caches, large binary assets, and generated code.
# This saves massive amounts of context tokens and drastically reduces API costs.
# ==============================================================================

# --- Android / Gradle Build Outputs & Caches (CRITICAL TOKEN SAVER) ---
build/
**/build/
.gradle/
**/.gradle/
.gradle-local/
.gradle-temp/
.kotlin/
**/.kotlin/
.cxx/
.externalNativeBuild/
captures/
benchmark-results/
app/build/
wear/build/
shared/build/
baselineprofile/build/

# --- Compiled Binaries & Large Package Archives ---
# Notice: root APK files (139MB+) must NEVER be indexed or traversed
*.apk
*.aab
*.dex
*.class
*.jar
*.aar
*.so
*.dylib
*.bin

# --- Version Control & IDE Metadata ---
.git/
**/.git/
.idea/
**/.idea/
.vscode/
**/.vscode/

# --- Binary Assets, Fonts & Media (Never read by LLM) ---
*.png
*.jpg
*.jpeg
*.webp
*.ico
*.ttf
*.otf
*.woff
*.woff2
*.mp3
*.flac
*.m4a
*.opus
*.ogg
*.wav
assets/
**/assets/
wear/src/main/res/font/
app/src/main/res/font/

# --- Keystores & Sensitive Local Properties ---
*.jks
*.keystore
local.properties
keystore.properties

# --- Logs, Crash Dumps & Temp Files ---
*.log
hs_err_pid*.log
*.tmp
*.temp

# --- Vendored native code & generated schemas (added: whisper.cpp = 6.8 MB of C/C++) ---
# The JNI bridge app/src/main/cpp/musicbabe_whisper_jni.c stays readable on purpose.
app/src/main/cpp/third_party/
app/schemas/
app/src/release/generated/
**/baseline-prof.txt
**/startup-prof.txt

# --- Docs, audits and design notes (read on demand, never indexed) ---
CHANGELOG.md
THIRD_PARTY_NOTICES.md
GLM_5.3_AUDIT_AND_FIXES.md
.impeccable/
docs/
*.svg
*.pdf

# --- Non-phone modules not touched by player features ---
wear/
baselineprofile/
remote-config/
